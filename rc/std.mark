#!/usr/bin/vash
#
#>>> std.mark
#
# mark menu items (files) and unmark them
#
:+
        * ?     _mark +
:-
        * +     _mark -
#       * *     _mark -

:TA
#:^
	* ?	_itmpos
#
### :SP does not work as key recognizer, use [ ]
### note: cursor advance to next item only on [ ] (space key hardcoded)
:KI
:[ ]
	* ?	_mark x#
#
# edit fill command, the same as -- tail calling vash
# :_
#       * ?     _mark _
:[_]
        * ?     _f_ls

#<<< std.mark
