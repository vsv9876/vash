#!/usr/bin/vash
#
# last resort section,
# may be used in any zero-level rc file as a last included one
#

:[=]
	* *     _rescan
#        * *     :cd .

#-------------------------------------------------------
# obsoleted, not compatible with UTF-8 encoded input,
# below at the end is a working rule - as a last resort of parsing process
#
# simple notify about wrong keyboard switch (normal working is in ascii),
# it is a prevention of koi8r-encoded input
#
# assumed this file is in koi8r but now in UTF-8
#:[Ю-Чю-ъ]
#	* *   _msg please, switch keyboard to en/latin

#-------------------------------------------------------
:[{]
        * *     _file #@
:[}]
        * *     _kshow

#
# View a substitution working in vash (for debug):
# 	#m - pager (from env PAGER, else more)
#       #e - editor (from env EDITOR, else vi)
#       #@ - an item pointed by cursor, this is usually the file name
#       #* - the name stripped from a suffix
#       #s - the suffix with a 'dot' symbol
#       #S - the suffix without a 'dot' symbol
#:@
:[']
###	* *     ;_sh echo # s='#s' S='#S' *='#*' e='#e'
#	* *     ;echo 'substr1? #[##] @[#@] $[#$]'
	* *     _msg '# 1  @[#@]  $[#$]'
:["]
###	* *     ;_sh echo # s='#s' S='#S' *='#*' e='#e'
#	* *     ;echo '2? m[#m] e[#e] *[#*] s[#s] S[#S]'
	* *     _msg '# 2  m[#m]  e[#e]  *[#*]  s[#s]  S[#S]'
# ------------

#
:RE
	* * ;clear
:Z
	* *	:exec vash
	
:^Z
#        * *     :/bin/csh -cf "suspend; exit 0;"
	* *     _sus

-9 setup
:U9
:9
    * *   _sup

# last resort keys
:[ -~]
	* * _att key is not assigned to any command
:^?
 	* * _att control key is not assigned
:??
 	* * _att function key is not assigned
:*
	* * _att Please, switch keyboard to ASCII/Latin mode

### EOF
