:
# file menu for compression, calling from misc.rc
#

#+ ## check if a selection is correct ##
for file in $@
do
    echo -n '#'
    if [ -f $file -a -s $file ]
    then
	continue
    else
	echo ''
	echo 'Error:'
	echo 'file is not apropriate for compression' $file
	if [ -f $file -a ! -s $file ]
	then
	   echo 'dummy file' ;
	fi
	if [ -d $file ]
	then
	    echo "it's a directory" ;
	fi
	if [ -c $file ]
	then
	    echo "it's special file (char. device)" ;
	fi
	if [ -b $file ]
	then
	    echo "it's special file (block device)" ;
	fi
	if [ -p $file ]
	then
	    echo "this is a pipe" ;
	fi
#        if [ -t $file ]
#        then
#            echo "it's special file (tty)" ;
#        fi
	echo ''
	ls -ld $file
	exit 1
    fi
#    echo ''
done
echo ''
exit 0


#+ gzip     # normal compression
gzip $@

#+ gzip -9  # highest compression
gzip -9 $@

#+ compress # standard (old-fasion) compress
compress $@

#+ compress -b12 # portable to 16bit platforms
compress -b12 $@

### EOF
