#!/usr/bin/vash
#
#>>> std.view

-3view

:3
:U3
	r?x ?   +View

+View
	r?? D *.tar.[zCp]    ;gzip -d < #@ | tar -tvf - | #m
	r?? D *.tar.bz2      ;bzip2 -cd < #@ | tar -tvf - | #m
	r?? D *.tar.gz       ;gzip -d < #@ | tar -tvf - | #m
	r?? D *.tar.xz       ;xz -d < #@ | tar -tvf - | #m
#	r?? D *.tar.[Z]      ;zcat < #@ | tar -tvf - | #m
	r?? D *.taz          ;gzip -d < #@ | tar -tvf - | #m
	r?? D *.tgz          ;gzip -d < #@ | tar -tvf - | #m
	r?? D *.zip          ;zipinfo -m #@ | #m
	r?? D *.arj          ;unarj l #@ | #m
	r?? D *.zoo          ;zoo l #@ | #m
	r?? D *.gz           ;gzip -d < #@ | #m
	r?? D *.bz2          ;bzip2 -d < #@ | #m
	r?? D *.xz           ;xz -d < #@ | #m
	r?? ? *.C            ;ccat #@ | #m
#----
	r?? [DT] *.cpio      ;cpio -itv -I#@ | #m
	r?? [DT] *.cpio.[Z]  ;zcat < #@ | cpio -itv | #m
	r?? [DT] *.cpio.gz   ;gzip -d < #@ | cpio -itv | #m
	r?? [DT] *.cpio.[zpC] ;gzip -d < #@ | cpio -itv | #m
	r?? [DT] *.[zCp]     ;gzip -d < #@ | #m
	r?? [DT] *.[Z]       ;zcat < #@ | #m
	r?? [DT] *.bz2       ;bzip2 -cd < #@ | #m
	r?? [DT] *.gz        ;gzip -d < #@ | #m
#	r?? [DT] *.gz-*      ;gzip -d < #@ | #m
	r?? [DT] *.xz        ;xz -d < #@ | #m
|+| r?? [DT] *.pkg       ;pkg info -F #@ | #m
|||	r?? [DT] *.src.rpm   ;rpm -qivp #@ | #m
	r?? [DT] *.rpm       ;rpm -qivp #@ | #m
	r?? [DT] *.deb       ;dpkg --info #@ | #m
|-
	r?? [AD] *.a         :ar tv #@ | #m
	r?? O *.o            :nm -np #@ | #m
	r?? O *.so           :nm -np #@ | #m
	r?? O *              nm -np #@ | #m
	r?? D *.tar          :tar -tvf #@ | #m
	r?? D *.[wj]ar       :unzip -l #@ | #m
	r?? D *.jpg	     :display #@
	r?? D *.JPG
	r?? D *.png	     :display #@
	r?? D *.tiff         :display #@
	r?? D *              ;od -a #@ | #m
	r?? T *              ;#m #@
# 	r?? E *              _msg file empty, zero length
# interface files in /dev, /sys,: stat(2) show them as zero length regular files
	r?? E *              :cat #@ | tr '\0' ' '
	r?x d *              :ls -aCF #@/.
#	r?? M *              frm -n #@
	r?? M *              mutt -Rf #@
#	??? ? *              _file #@
	??? ? *              :file #@; ls -ld #@

#<<< std.view
