#!/usr/bin/vash
#
# Processes and signals
# 
# first compose this script:
# Thu Nov 21 21:19:01 MVT 1991

# ps.main (this file) included from ps.rc and ps.all
-p ps
-: -s1 +pwR -l0

#
# preprocessed values:
# parameter -@ is depended from command of fill main menu -f
# which depends of calling mode - root or user
# and syntax of ps command (BSD or SYSV)
# 
# common parameters
-i/proc/.
-o/dev/null

# key info
#
#-1proc>
-2 HUP
-3 env
-4 QUIT
-5 TERM
# -6 
# -7 >ps.all
-8 KILL
-9 setup
-0 exit

@std.mark

@std.cmd

:U2
:2
    * -   kill -1 #$
    * +   kill -1 ##
:U3
|+
:3
    * ?   :ps -eww #@ | sed -E 's/( )([A-Za-z0-9_]*=)/\n\2/g' | #m
||
:3
    * ?   :ps -f e -p #@ | sed -E 's/( )([A-Za-z0-9_]*=)/\n\2/g' | #m
#    * *   ;ps -f e -p #@ | sed -E 's/( )([A-Za-z0-9_]*=)/\n\2/g' | #m
#    * +   :ps -f e -q #, | sed -E 's/( )([A-Za-z0-9_]*=)/\n\2/g' | #m
#    * +  :ps -f -q #, | #m
|-

:U4
:4
    * -   kill -3 #$
    * +   kill -3 ##
:U5
:5
    * -   kill -15 #$
    * +   kill -15 ##

#:U6
#:6
#    * -   :kill -0 #@
#    * +   kill -0 ##

#:U7
#:7
#    * *   exec vash ps.all
##    * *   _cmdset ps.all

:U8
:8
    * -   kill -9 #$
    * +   kill -9 ##
:U9
:9
    * *   _sup

:^D
:EX
:U0
:0
    * *     :exit
#:&
#    * *     _cmdset ps.rc
       
### list processes in long verbose format
:L
|+|  * -   :ps -lwwp #@
    * +   :ps -lwwp #,
|||  * -   :ps -fll -p #@
    * +   :ps -fll -q #,
|-

:=
    * * _rescan

@std.final
#<<< ps.common
