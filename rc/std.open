#!/usr/bin/vash
#
# file edit

#-4open+w

:NL
	??? ?   +Open

+Open
#
#----
#	r?x d .         _msg Купите на Привозе селедку и крутите ей мозги - мы стоим на Дерибасовской!  :)
#	r?x d .         _msg let You buy a fish on Privoz and screw a brain for him - we stay here on Deribasovskaja :)
#	r?x d .         _rescan
#----
	r?x d *              ;cd #$
#----
	r?? D *.tar.[zCp]    gzip -d < ./#@ | tar -xvf -
	r?? D *.tar.bz2      bzip2 -d < ./#@ | tar -xvf -
	r?? D *.tar.gz       gzip -d < ./#@ | tar -xvf -
	r?? D *.tar.xz       xz -d < ./#@ | tar -xvf -
#	r?? D *.tar.[Z]      zcat < ./#@ | tar -xvf -
	r?? D *.taz          gzip -d < ./#@ | tar -xvf -
	r?? D *.tgz          gzip -d < ./#@ | tar -xvf -
	r?? D *.zip          unzip ./#@
	r?? D *.arj          unarj x ./#@
	r?? D *.zoo          zoo x ./#@
	r?? D *.gz           gzip -d ./#@
	r?? D *.bz2          bzip2 -d ./#@
	r?? D *.xz           xz -d ./#@
#----
	r?? [DT] *.cpio      cpio -idm -I#@
	r?? [DT] *.cpio.[Z]  zcat < ./#@ | cpio -idm
	r?? [DT] *.cpio.gz   gzip -d < ./#@ | cpio -idm
	r?? [DT] *.cpio.[zpC] gzip -d < ./#@ | cpio -idm
	r?? [DT] *.[zCp]        gzip -d ./#@
	r?? [DT] *.[Z]          uncompress ./#@
	r?? [DT] *.bz2          bzip2 -d ./#@
	r?? [DT] *.gz           gzip -d ./#@
	r?? [DT] *.xz        xz -d ./#@
#    r?? [DT] *.deb      sudo dpkg -i ./#@
	r?? [DT] *.src.rpm   rpmbuild --rebuild ./#@
	r?? [DT] *.rpm       rpm -qp ./#@ ---
	r?? [DT] *.deb       dpkg-deb -x ./#@ /tmp/#@.d
# garbage remove from re demos2 editor
#	r?? [ET] .*.b       rm -f .*.b .,resv.*
#	r?? [ET] *.b        rm -f *.b .,resv.*
#----
	r?? A *             ar xv ./#@
	r?? [TD] *.sh       ./#$
	r?? T [Mm]ake*      make -f ./#@
	r?? [DT] *.tar      tar -xvf ./#@
	r?? [DT] *.[wj]ar   unzip -x ./#@
	r?? * *.man         ;nroff -man ./#@ | #m
# retro not in use
# 	r?? T *.lav         make #*.lb
# 	r?? T *.la          make #*.lb
# 	r?? T *.cv          make #*.c
	r?? T *.xpm         :sxpm ./#@ &
	r?? T *.c           make #*.o
	r?? T *.pl          make #*.pl
	r?? T .vashhist     _msg ./#@ Is not ash's program script
	r?? T .vash*        _cmdset ./#@
	r?? T *.rc          _cmdset ./#@
# a.out ОС XENIX в SYSV выглядит как неопознанные данные...
	??x [TOD] *     ./#$
	--x [-] *       ./#$
#	r?? M *         mailx -f ./#@
	r?? M *         mutt -f ./#@
#        r?? D *.bat     vpix z:#@
#        r?? D *.com     vpix z:#@
#        r?? D *.exe     vpix z:#@
	r?? D *.bat     dos #@
	r?? D *.com     dos #@
	r?? D *.exe     dos #@
	??? * *		_err no action defined for '#@'

#
