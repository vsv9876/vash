#include <stdio.h>
#include "line.h"

/*---------------------------*/
/* ВЫВОД СООБЩЕНИЯ ОБ ОШИБКЕ */
/*---------------------------*/
static  int errflg ;    /* ФЛАГ: СООБЩЕНИЙ ОБ ОШИБКЕ НЕ БЫЛО */

w_emsg ( str )
char    *str ;          /* ТЕКСТ СООБЩЕНИЯ ОБ ОШИБКЕ */
{
	if( *str ) {    /* ЕСЛИ АРГУМЕНТ ВЫЗОВА НЕПУСТАЯ СТРОКА */
		errflg = 1;
		cp_set(-1, 0, ERR);
		bell();
		printf(" ?!! %s ", str);
	} else {
		if(errflg) {
			errflg = 0;
			cp_set(-1, 0, TXT ) ;
			er_eol();
		}
	}
}

w_msg(attr, str)
int     attr;
char *str;
{
	w_emsg(str);
}
