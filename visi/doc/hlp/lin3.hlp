/*      +----------+    библиотека ввода-вывода */
/*     (c) linlib  !    для алфавитно-цифровых  */
/*      +----------+    видеотерминалов         */

#include "line.h"
/*
+------------------------- 1...79       размер поля на экране
!       +----------------- 0...23       строка
!       !       +--------- 0...78       колонка
!       !       !       +- SUS*  *=NL,U,D,L,R,T   (стопоры - suspenders)
!       !       !       !
+---    +---    +---    +---    ----    ----    ----    ----    ----
size    line    colu    flag    attr    cvts    cvtf    test    varl
--------------------------------------------------------------------

     поле доступно для ввода    INP
       у поля есть подсказка    PMT
----------------------------    ----    ----    ----    ----    ----

строка символов                 LVAR                    tst     s
центрируемый заголовок          LHDR                            "текст"
комментарий                     LTXT                            "текст"
переменная через формат         LVAR    "%M.Nf"         tst     &v
нестандартный формат            LVAR            cvt     tst     &v       (1
переключатель                   LALT    idxp    cvt_a   tst     &idxv    (2
пункт меню                      LMSE            case_m  tst_m   name_m   (2
----------------------------    ----    ----    ----    ----    ----
   Примечания:
(1 поле cvts можно задействовать для дополнительной информации
(2 все поля, кроме последнего, можно использовать по своему усмотрению
*/

char    s[];            /* строка символов */
float   v;              /* переменная любого типа, здесь - float */
int     tst();          /* тестирующая функция, указывать необязательно */
int     cvt();          /* функция форматного преобразования */
int     idxv;           /* индекс переключателя, а также:         */
char   *idxp[];         /* - текстовые названия каждого значения, */
int     cvt_a();        /* - библиотечная функция поддержки.      */

int     case_m();       /* функция, которую нужно вызвать, если    */
char    name_m[];         /*        указан этот пункт */
int     tst_m();        /*   тестирующая функция для меню из библиотеки */

LINE line = { size, line, colu, flag, attr, cvts, cvtf, test, varl };
LINE page[] = { {line1}, {line2}, ..., { 0 } };

vmain() {
	LINE *cline;    /* указатель на текущую линию */
	int   cpos;     /* текущая позиция при переходе в редактор строки */

	w_line( &line);   r_line( &line, &cpos );
	w_page( page );   r_page( page, &cline, &cpos );
}

tst(line, cod)
LINE *line;  kbcod cod; {
	return(TRUE);   /* введено правильное значение */
	return(FALSE);  /* что-то не так, повторить ввод */
}

