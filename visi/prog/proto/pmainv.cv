/*
 *      $Header$
 *      $Log$
 */

#include <stdio.h>
#include "line.h"       /* ФАЙЛ-ЗАГОЛОВОК LINLIB */


static  int ex_flg;     /* ФЛАГ: ПОРА ЗАКАНЧИВАТЬ */

mkexit()
{
	cp_set(-1, 0, TXT);
	ex_flg = 1;
	return(TRUE);
}


---PAGE linem
---LINES
m_exit  = ipm      -   -   mkexit  tst_m   " КОНЕЦ РАБОТЫ "

---SCREEN
=ПРОТОТИП ПРИКЛАДНОЙ ПРОГРАММЫ  LINLIB V3.4







			.m_exit...............................




   .:?  .:HE....  ВЫВОД ПОДСКАЗКИ (HELP)

	.:RE....  ПЕРЕРИСОВКА ЭКРАНА (REFRESH)
---END


vmain()
/*------------*/
/* VIDEO MAIN */
/*------------*/
{
	kbcod cod;
	LINE *cline;
	cline = 0;

	er_pag();
	w_page(linem);

	for( ;; ) {
		cod = r_page(linem, &cline, 0);
		/* ФЛАГ ВЗВОДИТСЯ ЧЕРЕЗ ФУНКЦИЮ ОБСЛУЖИВАНИЯ МЕНЮ */
		if(ex_flg) return;

		switch(cod) {
		case ' ' :
			/* ПЕРЕРИСОВАТЬ ПОСЛЕ МЕНЮ */
			if((cline->attr & LMSE) == LMSE) {
				er_pag();
				w_page(linem);
			}
			break;
		case '?':
		case KB_HE:
			/* ВЫВОД СПРАВОЧНОЙ ИНФОРМАЦИИ */
			w_help(0); w_page(linem);
			break;
		case KB_EX :
			/* ЗВОНОК, ИЗ ЭТОЙ СТРАНИЦЫ
			 * ПОДНИМАТЬСЯ НЕКУДА
			 */
			bell();
			break;
		default :
			w_emsg("");
			cp_set(-1, 0, TXT);
			printf("<%c%c>", cod1(cod), cod0(cod));
			fflush(vttout);
			break;
		}
	}
}
