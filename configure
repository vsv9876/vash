#!/bin/bash

#echo Warning! there no automatic configuration prepared,
#echo please, use 'make cfg' instead
BLDCONF=./conf.cfg

mypwd=`pwd`
mydir=`basename $mypwd`
VERSN="$mydir"

# > $BLDCONF	echo '#' `date`
# >
 > $BLDCONF	echo ''
 >> $BLDCONF	echo 'TOPDIR    = '`pwd`
# >> $BLDCONF	echo ''
 >> $BLDCONF	echo 'DEST      = /usr'
# >> $BLDCONF	echo ''
 >> $BLDCONF	echo 'VERSN     = "'$VERSN'"'
# >> $BLDCONF	echo ''
 workdir="$mypwd/visi/bin"
 grep -e "$workdir:" <<EOF >/dev/null
$PATH
EOF
 if [ $? -ne 0 ]; then
 PATH="$mypwd/visi/bin:$PATH"
 fi
 >> $BLDCONF	echo 'PATH      = '$PATH
 >> $BLDCONF	echo ''
#make cfg

exit 0
