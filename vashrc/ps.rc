#!/usr/bin/vash
#
#-----------------------------------------
# Стандартная настройка интерпретатора ash
# суб сен  8 02:19:11 MSD 1990
# Thu Nov 21 21:19:01 MVT 1991
# Процессы и сигналы
#
#-----------------------------------------
#
# Умолчания: заполнить(fill), откуда(in), куда(out).
#
-fexec ps -f -u $LOGNAME
-i
-o/dev/null
-@2
#
# -@$3
# -@20-25
# -@
# формат подстановки для #@, ## - означает,
# какую часть строки подставлять в команду
#------------------------------------------

# НАЗВАНИЯ КЛАВИШ
#-1proc>
-2INT
-3test
-4QUIT
-5TERM
-6
-7ALRM
-8KILL
-9SETUP
-0exit

@std.mark

@std.cmd

:U2
:2
       * -   kill -1 #@
       * +   kill -1 ##
:U3
:3
       * -   kill -0 #@
       * +   kill -0 ##
:U4
:4
       * -   kill -3 #@
       * +   kill -3 ##
:U5
:5
       * -   kill -15 #@
       * +   kill -15 ##
:U7
:7
       * -   kill -14 #@
       * +   kill -14 ##
:U8
:8
       * -   kill -9 #@
       * +   kill -9 ##
:U9
:9
       * *   _sup
:EX
:U0
:0
       * *     :exit
:&
       * *     _cmdset ps.rc

:=
    * * _rescan

@std.final
