#!/usr/bin/vash
#
#-----------------------------------------
# Стандартная настройка интерпретатора ash
# суб сен  8 02:19:11 MSD 1990
# Thu Nov 21 21:19:01 MVT 1991
# Процессы и сигналы
#
#-----------------------------------------
#
# Умолчания: заполнить(fill), откуда(in), куда(out).
#
#-fexec ps -f -t `tty` -u $LOGNAME
-fexec ps -x
-i/proc/.
-o/dev/null
-@1
#
# -@$3
# -@20-25
# -@
# формат подстановки для #@, ## - означает,
# какую часть строки подставлять в команду
#------------------------------------------

# НАЗВАНИЯ КЛАВИШ
#-1proc>
-2HUP
-3env
-4QUIT
-5TERM
-6test
-7ALRM
-8KILL
-9setup
-0exit

@std.mark

@std.cmd

:U2
:2
    * -   kill -1 #@
    * +   kill -1 ##
:U3
:3
    * *   ;ps -f e -p #@ | sed -E 's/( )([A-Za-z0-9_]*=)/\n\2/g' | #m
#    * +   :ps -f e -q #, | sed -E 's/( )([A-Za-z0-9_]*=)/\n\2/g' | #m
#    * +  :ps -f -q #, | #m
:U4
:4
    * -   kill -3 #@
    * +   kill -3 ##
:U5
:5
    * -   kill -15 #@
    * +   kill -15 ##
:U6
:6
    * -   kill -0 #@
    * +   kill -0 ##
:U7
:7
    * -   kill -14 #@
    * +   kill -14 ##
:U8
:8
    * -   kill -9 #@
    * +   kill -9 ##
:U9
:9
    * *   _sup

:^D
:EX
:U0
:0
    * *     :exit
:&
    * *     _cmdset ps.rc
       
:L
    * -   :ps -fll -p #@
    * +   ;ps -fll -q #, | #m

:=
    * * _rescan

@std.final
