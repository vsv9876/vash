#! /usr/bin/vash
#
# misc.rc
# 
# create file/directorie/etc..
#
# Wed Sep 12 15:46:39 MSD 1990
#
#
-f:FLa
-i.
-o.
-@

# НАЗВАНИЯ КЛАВИШ
-1-misc-
-2compr
-3
-4touch
-5tar
-6cpio
-7dir
-8
-9
-0return


@std.mark


:[?]
:HE
    * *     _help 7misc.lb
:NL
:EX
:U0
:0
    * *     _cmdset std.rc
# Редактирование последней команды sh:
:[1!]
    r?x ?   _sh

:2
:U2
	rwx +   _menu2 compr.menu
	rwx -   _err please, mark files using spacebar
	r-x *   +Cant

:U4
:4
    rwx -   +touch
    rwx +   +touchf
    * *     +Cant
+touch
    ?w? ?   touch #@

+touchf
    ??? ?   touch ##

+Cant
    * * *   _err Can't write this directory

:@
    rwx -   _msg rwx -
    rwx +   _msg rwx +
    r-x -   _msg rwx -
    r-x +   _msg rwx +

:U5
:5
    rwx -   +tardir
    rwx +   +tarfiles
    r-x *   +Cant


+tardir

    * d * tar -cvf #@.tar #@
    * * * _msg please, point with coursor to directory or mark files

+tarfiles

    * ? * tar -cvf .tar ##
    * * * _msg err in .ashmisc
:U6
:6
    rwx -   +cpiodir
    rwx +   +cpiofiles
    r-x *   +Cant

+cpiodir

    * d . find #@ -depth -print | grep -v '^\./\.\.cpio' | cpio -odv > #@.cpio
    * d * find #@ -depth -print | cpio -odv > #@.cpio
    * * * _msg please, point to directory or mark files

+cpiofiles

    * ? * find ## -depth -print | cpio -odv > .cpio

:U7
:7
	rwx ?   mkdir .
	* *     +Cant
:KI
	* * _cmdset misc.rc

@std.final
