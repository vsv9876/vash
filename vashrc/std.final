#
# std.final
#
# last resort section,
# may be used in any *.rc as a last included file
#

:[=]
	* *     _rescan
#        * *     :cd .

#-------------------------------------------------------
# obsoleted, not compatible with UTF-8 encoded input
#
#       Простое напоминание (так как работа идет в латинском регистре),
#       но в принципе здесь возможна и другая точка зрения.
# Диапазон зависит от кодовой таблицы, здесь КОИ-8

#:[Ю-Чю-ъ]
#	* *   _msg please, switch keyboard to en/latin
#-------------------------------------------------------
#:[#]
#        * *     _kshow

# Посмотреть подстановки ash (для отладки:
#       #e - редактор (из переменной окружения EDITOR, или re)
#       #@ - имя возле курсора (строка главного меню, обычно имя файла).
#       #* - имя без суффикса
#       #s - суффикс имени с точкой
#       #S - суффикс имени без точки
:@
#	* *     ;_sh echo # s='#s' S='#S' *='#*' e='#e'
	* *     ;echo # s='#s' S='#S' *='#*' e='#e'
:Z
	* *	:exec vash
	
# last resort keys
:[ -~]
	* * _msg key is not assigned to any command
:^?
# 	* * _msg undefined key (.ashstd || termcap)
 	* * _msg control key is not assigned
:??
# 	* * _msg undefined key (.ashstd || termcap)
 	* * _msg function key is not assigned
:*
	* * _msg Please, switch keyboard to ASCII/Latin mode

