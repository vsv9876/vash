#!/usr/bin/vash
#
# std.mark
#
# mark menu items (files) and unmark them
#
:+
        * ?     _mark +
:-
#        * +     _mark -
        * *     _mark -
:>
	* ?	_mark >#
:<
	* ?	_mark <#

# :SP does not work due to bug in vash code
:SP
:KI
# workaround for SP also working an '#' (MONEY)
:[ #]
	* ?	_mark x#
#
# edit fill command, the same as -- tail calling vash
# :_
#       * ?     _mark _
:[*_]
        * ?     _f_ls
