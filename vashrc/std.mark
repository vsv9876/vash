#-------------------------------------------------------
#
# Реакция на клавишу. Проверяется 2 условия:
# rwx     :полномочия доступа к реперному файлу (здесь к текущему каталогу)
# - или + :наличие помеченных файлов
#-------------------------------------------------------
:+
        * ?     _mark +
:-
        * ?     _mark -
# :_
#       * ?     _mark _
:[*_]
        * ?     _f_ls
