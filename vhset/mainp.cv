/* #undef  LVAR */
/* #define LVAR TXT */

static
---PAGE mainm
---LINES
m_m  = ipm      n   -   pag_mk  tst_m   " Basic commands "
m_k  = ipm      n   -   pag_k   tst_m   " Other commands "
m_a  = ipm      n   -   pag_a   tst_m   " Video attributes "
m_qu = ipm      n   -   mkquit  tst_m   " QUIT (discard changes) "
m_ex = ipm      n   -   mkexit  tst_m   " EXIT (save setup) "
lh   = v        -   -   -       -       namelh
sp   = gv       -   -   -       -       "spacebar"

---SCREEN
=VHSET - video-display hardware setup

---#  LINLIB V3.4

---#  Exit from setup:
        .m_qu......................
---#    .m_m.......................
       	.m_a.......................
        .m_k.......................
        .m_ex......................


 Please, press a key:

---#		-- advance to next menu point
---#	    select menu: .sp.....
---#		      or .:NL....

	    get help:    .:HE....

    file:  .lh................................................................

---#    .:?  or .:HE.... -- Help
---END
