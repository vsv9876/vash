/* #undef  LVAR */
/* #define LVAR TXT */

static
---PAGE mainm
---LINES
m_m  = ipm      n   -   pag_mk  tst_m   " Basic keyboard setup "
m_k  = ipm      n   -   pag_k   tst_m   " Keys & codes setup "
m_a  = ipm      n   -   pag_a   tst_m   " Video setup "
m_qu = ipm      n   -   mkquit  tst_m   " Quit (discard changes) "
m_ex = ipm      n   -   mkexit  tst_m   " Exit (save settings) "
lh   = g        -   -   -       -       namelh
sp   = gv       -   -   -       -       "spacebar"

---SCREEN
=VHSET - video-display hardware setup

 profile:
    .lh......................................................................


---#  LINLIB V3.4

---#  Exit from setup:
        .m_qu......................

---#    .m_m.......................
        .m_a.......................
        .m_k.......................

        .m_ex......................


  get help:    .:HE....


---END
