static
---PAGE pkeys0
---TABLES
	t   = (void *)sizeof(KBL)

---PORTS
KO_P    = kbl[0].t_knm

---LINES
KO      = ipv   -       -       cvt_s   -       KO_P
---#sp      = gh    -       -       -       -       "spacebar"

---SCREEN
=Basic keys setup

    ."Key"..   ."Description"...    ."shirt rules description:".........    
                                    Setup will be done in two steps.    
    .KO.....   keypad (on/off)
                                    step 1: assign new key:    
    .t......   cursor up               press a key desired;
    .t......   cursor down             press .:SP.... to cancel
    .t......   cursor left             
    .t......   cursor right
				    step 2: edit key label:
    .t......   space                   press .:SP.... to edit label;
    .t......   Tab                     press .:NL.... when complete

    .t......   Enter/Return 
                                    step 3: when done,
                                       press Exit key .:EX....   

---END
