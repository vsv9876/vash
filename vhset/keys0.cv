static
---PAGE pkeys0
---TABLES
	t   = sizeof(KBL)

---PORTS
KO_P    = &kbl[0].t_knm;

---LINES
KO      = ipv   -       -       cvt_sp  -       KO_P
sp      = gh    -       -       -       -       "spacebar"

---SCREEN
=Basic keys setup

    ."Key"..   ."Name".........     ."shirt rules description:".........    
                                    Setup will be done in two steps.    
    .KO.....   keypad (on/off)
                                    step 1: to assign new value of keys:    
    .t......   cursor up               press in order    
    .t......   cursor down             (from up to down)    
    .t......   cursor left             press .sp..... to cancel    
    .t......   cursor right
				    step 2: to edit names of keys:    
    .t......   Enter                   press .sp.....    
    .t......   Delete                  to switch edit mode    

    .t......   Exit/prefix          step 3: to complete a job:            
                                       press Exit key    


---END
