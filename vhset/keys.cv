static
---PAGE mainm
---PORTS

Kcod    = &kbl[5].t_cod
Klbl    = &kbl[5].t_knm
T_kbl1  = &(kbl[7])
T_kbl2  = &(kbl[7])

---TABLES
tn      = sizeof(keynam[0])
t       = sizeof(KBL)

---LINES
KDESCR  = gc     -      -       cvt_keynm   -   Kcod
KCOD    = gc     -      -       cvt_keycod  -   Kcod

KL      = ipv    -      -       cvt_s   -       Klbl

K1      = ipa    -      "1"     cv_kbl  -       T_kbl1
K2      = ipa    -      "2"     cv_kbl  -       T_kbl2

---SCREEN
---#                     
---#."Keys setup"............. ."Assignment logic     Main key....     2nd".
=Keys&codes setup

                                       ."Code      Label    key    key2".                                                          
