/* атрибуты видео, специально переопределенные для использования внутри vhset */

#define USRATTR8 CMD|PAD|NED
#define USRATTR1 TXT|PAD|NED
/*#define USRATTR2 HDR|PAD|NED|MID*/
#define USRATTR2 HDR|PAD|NED
#define USRATTR3 VAR|PAD|NED
#define USRATTR4 ALT|PAD|NED
#define USRATTR5 MSE|PAD|NED
#define USRATTR6 ERR|PAD|NED
#define USRATTR7 SEL|PAD|NED

#define USRATTR0 HDR|PAD

#undef  LALT
/*#define LALT ATT|MID|NED*/
/*#define LALT MSE|MID|NED*/
#define LALT TXT|MID|NED

---PAGE linem
---PORTS
	LPA_B = 0
	LPA_PI = &lpa_pi;
	W_so   = &wamask[0]; /* not supported */
	W_us   = &wamask[1];
---#	W_vs   = &wamask[2]; /* not a video attribute */
	W_md   = &wamask[3];
	W_mr   = &wamask[4];
	W_mb   = &wamask[5];
	W_mk   = &wamask[6];
	W_mh   = &wamask[6]; /* dim */
	W_zh   = &wamask[7]; /* italic */
	SGR    = &sgrmode;
---#	SGR_B  = 0
---#	SGRA   = &sgra;
	SGRAT  = &sgrats[0];
---#	CO_fg  = "0";
---#	CO_bg  = "1";
---TABLES
	t = (void *)1;
---LINES
	P       = ia - -      cvt_pmt - LPA_B
	C       = g8p - -      cvt_atr - " $  "
	T       = g1p - -      cvt_atr - " txt"
	H       = g2p - -      cvt_atr - " hdr"
	V       = g3p - -      cvt_atr - " 123"
	A       = g4p - -      cvt_atr - " [*]"
	M       = g5p - -      cvt_atr - " off"
	E       = g6p - -      cvt_atr - " msg"
	S       = g7p - -      cvt_atr - " <<<"

	so      = ia - W_so   cvt_va  - LPA_B
	us      = ia - W_us   cvt_va  - LPA_B
---#	vs      = ia - W_vs   cvt_va  - LPA_B
	mh      = ia - W_mh   cvt_va  - LPA_B
	md      = ia - W_md   cvt_va  - LPA_B
	mr      = ia - W_mr   cvt_va  - LPA_B
	mb      = ia - W_mb   cvt_va  - LPA_B
	mk      = ia - W_mk   cvt_va  - LPA_B
	mi	= ia - W_zh   cvt_va  - LPA_B

	hl      = g1  - -     cvt_hl  - "."

	sgrAT   = g  - -      -       - SGRAT 
	sgrm    = ai - sgrms cvt_a   sgrtst SGR
	mode    = gc - -      -       - "color mode:"
	   g    = gn - -      -       - ". .    "
	   c    = gc - -      -       - ". .    "

	Bf	= ia - "f"   cvt_cb  - LPA_B
	Bb	= ia - "b"   cvt_cb  - LPA_B
	fg      = ia - "f"   cvt_co  - LPA_B
	bg      = ia - "b"   cvt_co  - LPA_B
	sgr     = ia - -     cvt_sgr - LPA_B
	M1      = g1 - "| "  cvt_pi  - LPA_B
	p0      = g1 - "0"   cvt_pim - -
	p1      = g1 - "1"   cvt_pim - -
	lh      = g  - -     -       - namelh



---SCREEN
---#
---# WARNING! please, keep in mind that
---# column of elements in string 3 (which contains .CMD. .TXT. .HDR. ...)
---# must be equal a column of corresponding element in the matrox of
---# attribute selectors (which contains .t) because
---# format conversion function for selector depends on screen coordinates of it.
---# for example, columns of fields .t and .HDR must be the same
---# 
---# place of '.sgrAT' line must be below '.sgr' line
---#.lh........................................................................
---#
---#=video attributes
---#line type: ." CMD     TXT     HDR     VAR     ALT     MSE     ERR     SEL ".        
."line type:".. ."CMD". ."TXT". ."HDR". ."VAR". ."ALT". ."MSE". ."ERR". ."SEL".         
---#        .p0....  
---#        .p1....
                
                 .C...   .T...   .H...   .V...   .A...   .M...   .E...   .S... 

 ."attribute"..                                                                 
!     prompter:  .P.     .t.     .t.     .t.     .t.     .t.     .t.     .t.    
!   standout:so  .so     .t.     .t.     .t.     .t.     .t.     .t.     .t.
!  underline:us  .us     .t.     .t.     .t.     .t.     .t.     .t.     .t.
!        dim:mh  .mh     .t.     .t.     .t.     .t.     .t.     .t.     .t.
!       bold:md  .md     .t.     .t.     .t.     .t.     .t.     .t.     .t.
!    reverse:mr  .mr     .t.     .t.     .t.     .t.     .t.     .t.     .t. 
!      blink:mb  .mb     .t.     .t.     .t.     .t.     .t.     .t.     .t. 
---#+ hidden:mk  .mk.    .t.     .t.     .t.     .t.     .t.     .t.     .t. 
!     italic:mi  .mi     .t.     .t.     .t.     .t.     .t.     .t.     .t. 
!."color"......							     
! foreground #:  .fg     .t.     .t.     .t.     .t.     .t.     .t.     .t. 
!    fg bright:  .Bf     .t.     .t.     .t.     .t.     .t.     .t.     .t. 
! background #:  .bg     .t.     .t.     .t.     .t.     .t.     .t.     .t.  
!    bg bright:  .Bb     .t.     .t.     .t.     .t.     .t.     .t.     .t.
!FG+BG compose:  .sgr    .t.     .t.     .t.     .t.     .t.     .t.     .t.
 ."mode".......
   .sgrm...............         SGR: .sgrAT.....        .:HE.... help
							.:KI.... switch the set

---#!."color"......	.M1    .t.    .t.    .t.    .t.    .t.    .t.    .t.
---# debug garbage below...
---#+         vs:vs  .vs.    .t.     .t.     .t.     .t.     .t.     .t.     .t.
---#+       code edit:  .hl... .hl... .hl... .hl... .hl... .hl... .hl... .hl...
---#	 ."mode:".  .sgrm..........     .sgrAT.....          get help: .:HE....
---# markup:
---#	:  :          :...  :...  :...  :...  :...  :...  :...  :...  :........:
---#+                      .hl.................................................
---#+           .hl............................................................
---#+.""...........................................................................
---END
