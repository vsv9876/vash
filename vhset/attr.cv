/* атрибуты видео, специально переопределенные для использования внутри vhset */

#define USRATTR8 CMD|PAD|NED
#define USRATTR1 TXT|PAD|NED
/*#define USRATTR2 HDR|PAD|NED|MID*/
#define USRATTR2 HDR|PAD|NED
#define USRATTR3 VAR|PAD|NED
#define USRATTR4 ALT|PAD|NED
#define USRATTR5 MSE|PAD|NED
#define USRATTR6 ERR|PAD|NED
#define USRATTR7 ATT|PAD|NED

/*#define USRATTR0 HDR|MID|PAD|NED*/
#define USRATTR0 HDR|PAD

#undef  LALT
#define LALT TXT|MID|NED
#define LALT ALT|MID|NED
#undef  LHDR
#define LHDR HDR|PAD|NED|PMT
/* #define USRATTR0 LALT*/

---PAGE linem
---PORTS
	LPA_B = 0
	LPA_PI = &lpa_pi;
	W_so   = &wamask[0];
	W_us   = &wamask[1];
	W_vs   = &wamask[2];
	W_md   = &wamask[3];
	W_mr   = &wamask[4];
	W_mb   = &wamask[5];
	W_mk   = &wamask[6];
	SGR    = &sgrmode;
---#	SGR_B  = 0
---#	SGRA   = &sgra;
	SGRAT  = &sgrats[0];
---#	CO_fg  = "0";
---#	CO_bg  = "1";
---TABLES
	t = 1;
---LINES
	P       = ia - -      cvt_pmt - LPA_B
	CMD     = g8p - -      cvt_atr - "cmd "
	TXT     = g1p - -      cvt_atr - "TXT "
	HDR     = g2p - -      cvt_atr - "HDR "
	VAR     = g3p - -      cvt_atr - "VAR "
	ALT     = g4p - -      cvt_atr - "ALT "
	MSE     = g5p - -      cvt_atr - "MSE "
	ERR     = g6p - -      cvt_atr - "ERR "
	ATT     = g7p - -      cvt_atr - "ATT "
	so      = ia - W_so   cvt_va  - LPA_B
	us      = ia - W_us   cvt_va  - LPA_B
	vs      = ia - W_vs   cvt_va  - LPA_B
	md      = ia - W_md   cvt_va  - LPA_B
	mr      = ia - W_mr   cvt_va  - LPA_B
	mb      = ia - W_mb   cvt_va  - LPA_B
	mk      = ia - W_mk   cvt_va  - LPA_B
	hl      = gca - -     cvt_hl  - "."

	sgrAT   = v  - -      -       - SGRAT 
	sgrm    = ai - sgrms cvt_a   sgrtst SGR
---#	mode    = g  - -      -       - "mode:"
	mode    = gc - -      -       - "mode:"
	   g    = gn - -      -       - ". .    "
	   c    = gc - -      -       - ". .    "

	fg      = ia - "f"   cvt_co  - LPA_B
	bg      = ia - "b"   cvt_co  - LPA_B
	sgr     = ia - -     cvt_sgr - LPA_B
---# 	pi      = g0 - "# "  cvt_pi  - LPA_B
	M       = g1 - "# "  cvt_pi  - LPA_B
	pimsg0  = g  - "0"   cvt_pim - -
	pimsg1  = g  - "1"   cvt_pim - -
---#	lh      = v  - -     -       - namelh
	lh      = g2 - -     -       - namelh

---#
---# WARNING! please, keep in mind that
---# column of elements in string 4 (contains .TXT. .HDR. ...) must be equal
---# an column of corresponding element in matrox of attribute selectors (contains .t) -
---# format conversion function for selector depends on screen coordinates of it.
---# for example, columns of fields .t and .HDR must be the same
---# 
---# place of .sgraAT line must be below .sgr line
---SCREEN
+.pimsg0.........   .CMD.  .TXT.  .HDR.  .VAR.  .ALT.  .MSE.  .ERR.  .ATT.
+
+.pimsg1.........
+
---#+                          .M     .t.    .t.    .t.    .t.    .t.    .t.
---#+.pimsg1.........          .M     .t.    .t.    .t.    .t.    .t.    .t.
---#+                          .M.    .t.    .t.    .t.    .t.    .t.    .t.
=Video attributes
+
+   line prompter:  .P.    .t.    .t.    .t.    .t.    .t.    .t.    .t.
+."monochrome"....         .M.    .t.    .t.    .t.    .t.    .t.    .t.
+     outstand(so)  .so    .t.    .t.    .t.    .t.    .t.    .t.    .t.
+    underline(us)  .us    .t.    .t.    .t.    .t.    .t.    .t.    .t.
+  bright/bold(md)  .md    .t.    .t.    .t.    .t.    .t.    .t.    .t.
+      reverse(mr)  .mr    .t.    .t.    .t.    .t.    .t.    .t.    .t.
+        blink(mb)  .mb    .t.    .t.    .t.    .t.    .t.    .t.    .t.
+."color".........         .M.    .t.    .t.    .t.    .t.    .t.    .t.
+   foreground(fg)  .fg    .t.    .t.    .t.    .t.    .t.    .t.    .t.
+   background(bg)  .bg    .t.    .t.    .t.    .t.    .t.    .t.    .t.
+    stripe(fg,bg)  .sgr   .t.    .t.    .t.    .t.    .t.    .t.    .t.
+
.lh.............................................................................
           .mode..  .sgrm..........  SGR debug: .sgrAT.....
	   
 help: .:HE.... toggle mode w/r: .:KI....

---# dbeug garbage below...
---#+		    .pi    .t     .t     .t     .t     .t     .t     .t  
---#+       code edit:  .hl... .hl... .hl... .hl... .hl... .hl... .hl... .hl...
---#	 ."mode:".  .sgrm..........     .sgrAT.....          get help: .:HE....
---# markup:
---#	:  :       :...   :...   :...   :...   :...   :...   :...   :...  :........:
---#	:  :          :...  :...  :...  :...  :...  :...  :...  :...  :........:
---#+    .hl...............................................................
---#+	.hl............................................
---#+									
---#+    :mk/hidden         .mk.  .t..  .t..  .t..  .t..  .t..  .t..  .t..
---#+    :vs/background     .vs.  .t..  .t..  .t..  .t..  .t..  .t..  .t..    
---END
