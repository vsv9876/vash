/* атрибуты видео, специально переопределенные для использования внутри vhset */

#define USRATTR8 CMD|MID|PAD|NED
#define USRATTR1 TXT|MID|PAD|NED
#define USRATTR2 HDR|MID|PAD|NED
#define USRATTR3 VAR|MID|PAD|NED
#define USRATTR4 ALT|MID|PAD|NED
#define USRATTR5 MSE|MID|PAD|NED
#define USRATTR6 ERR|MID|PAD|NED
#define USRATTR7 ATT|MID|PAD|NED
#undef  LALT
#define LALT TXT|MID|NED

---PAGE linem
---PORTS
	LPA_B = 0
	LPA_PI = &lpa_pi;
	W_so   = &wamask[0];
	W_us   = &wamask[1];
	W_vs   = &wamask[2];
	W_md   = &wamask[3];
	W_mr   = &wamask[4];
	W_mb   = &wamask[5];
	W_mk   = &wamask[6];
	SGR    = &sgrmode;
---#	SGR_B  = 0
	SGRA   = &sgra;
	SGRATS = &sgrats[0];
---TABLES
	t = 1;
---LINES
	P       = ia - -      cvt_pmt - LPA_B
	CMD     = g8 - -      cvt_atr - " cmd "
	TXT     = g1 - -      cvt_atr - " TXT "
	HDR     = g2 - -      cvt_atr - " HDR "
	VAR     = g3 - -      cvt_atr - " VAR "
	ALT     = g4 - -      cvt_atr - " ALT "
	MSE     = g5 - -      cvt_atr - " MSE "
	ERR     = g6 - -      cvt_atr - " ERR "
	ATT     = g7 - -      cvt_atr - " ATT "
	so      = ia - W_so   cvt_va  - LPA_B
	us      = ia - W_us   cvt_va  - LPA_B
	vs      = ia - W_vs   cvt_va  - LPA_B
	md      = ia - W_md   cvt_va  - LPA_B
	mr      = ia - W_mr   cvt_va  - LPA_B
	mb      = ia - W_mb   cvt_va  - LPA_B
	mk      = ia - W_mk   cvt_va  - LPA_B
	hl      = gca - -     cvt_hl  - "."
	sgr     = ia - -      cvt_sgr - LPA_B
---#	sgrA    = v  - -      cvt_sg  - SGRA
	sgrATS  = v  - -      -       - SGRATS
	sgrm    = ai - sgrms cvt_a   sgrtst SGR
---#
---# WARNING!
---# Do not touch string 4 (contains .TXT. .HDR. ...), because
---# format conversion function for selector depends on screen coordinates of it.
---# for example, columns of fields .t and .HDR must be the same
---# 
---# place of .sgra line must be below .sgr line??? TODO cleanup this comment
---SCREEN
=visual/video attributes setup

+     prompt            .P..  .t..  .t..  .t..  .t..  .t..  .t..  .t..
+       .hl............................................................
+                       .CMD. .TXT. .HDR. .VAR. .ALT. .MSE. .ERR. .ATT.  
+     demo/test									
+									
+    .hl...............................................................
+    :so:outstand       .so.  .t..  .t..  .t..  .t..  .t..  .t..  .t..     
+    :us:underline      .us.  .t..  .t..  .t..  .t..  .t..  .t..  .t..
+    :md:bright/bold    .md.  .t..  .t..  .t..  .t..  .t..  .t..  .t..
+    :mr:reverse        .mr.  .t..  .t..  .t..  .t..  .t..  .t..  .t..
+    :mb:blink          .mb.  .t..  .t..  .t..  .t..  .t..  .t..  .t..
---#+    :mk:hidden         .mk.  .t..  .t..  .t..  .t..  .t..  .t..  .t..
---#+    :vs:background     .vs.  .t..  .t..  .t..  .t..  .t..  .t..  .t..    
+    .hl...............................................................
+    mode: .sgrm.......	.sgr  .t.   .t..  .t..  .t..  .t..  .t..  .t..
---#+          	      %	.sgrA......							  
+		       	.sgrATS....
+	.hl.............................................................
+              		
---#	:  :          :...  :...  :...  :...  :...  :...  :...  :...  :........:
---END
