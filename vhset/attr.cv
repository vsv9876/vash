/* атрибуты видео, специально переопределенные для использования внутри vhset */

#define USRATTR8 CMD|MID|PAD|NED|PMT
#define USRATTR1 TXT|MID|PAD|NED|PMT
#define USRATTR2 HDR|MID|PAD|NED|PMT
#define USRATTR3 VAR|MID|PAD|NED|PMT
#define USRATTR4 ALT|MID|PAD|NED|PMT
#define USRATTR5 MSE|MID|PAD|NED|PMT
#define USRATTR6 ERR|MID|PAD|NED|PMT
#define USRATTR7 ATT|MID|PAD|NED|PMT

#define USRATTR0 MSE|MID|PAD|NED

#undef  LALT
#define LALT TXT|MID|NED

---PAGE linem
---PORTS
	LPA_B = 0
	LPA_PI = &lpa_pi;
	W_so   = &wamask[0];
	W_us   = &wamask[1];
	W_vs   = &wamask[2];
	W_md   = &wamask[3];
	W_mr   = &wamask[4];
	W_mb   = &wamask[5];
	W_mk   = &wamask[6];
	SGR    = &sgrmode;
---#	SGR_B  = 0
---#	SGRA   = &sgra;
	SGRAT  = &sgrats[0];
---#	CO_fg  = "0";
---#	CO_bg  = "1";
---TABLES
	t = 1;
---LINES
	P       = ia - -      cvt_pmt - LPA_B
	CMD     = g8 - -      cvt_atr - "cmd "
	TXT     = g1 - -      cvt_atr - "TXT "
	HDR     = g2 - -      cvt_atr - "HDR "
	VAR     = g3 - -      cvt_atr - "VAR "
	ALT     = g4 - -      cvt_atr - "ALT "
	MSE     = g5 - -      cvt_atr - "MSE "
	ERR     = g6 - -      cvt_atr - "ERR "
	ATT     = g7 - -      cvt_atr - "ATT "
	so      = ia - W_so   cvt_va  - LPA_B
	us      = ia - W_us   cvt_va  - LPA_B
	vs      = ia - W_vs   cvt_va  - LPA_B
	md      = ia - W_md   cvt_va  - LPA_B
	mr      = ia - W_mr   cvt_va  - LPA_B
	mb      = ia - W_mb   cvt_va  - LPA_B
	mk      = ia - W_mk   cvt_va  - LPA_B
	hl      = gca - -     cvt_hl  - "."

	sgrAT   = v  - -      -       - SGRAT 
	sgrm    = ai - sgrms cvt_a   sgrtst SGR
	mode    = g  - -      -       - "mode:"

	fg      = ia - "f"   cvt_co  - LPA_B
	bg      = ia - "b"   cvt_co  - LPA_B
	sgr     = ia - -     cvt_sgr - LPA_B
	pim     = g0 - "| "  cvt_pi  - LPA_B
	pimsg0  = g  - "0"   cvt_pim - -
	pimsg1  = g  - "1"   cvt_pim - -

---#
---# WARNING! please, keep in mind that
---# column of elements in string 4 (contains .TXT. .HDR. ...) must be equal
---# an column of corresponding element in matrox of attribute selectors (contains .t) -
---# format conversion function for selector depends on screen coordinates of it.
---# for example, columns of fields .t and .HDR must be the same
---# 
---# place of .sgraAT line must be below .sgr line
---SCREEN
.pimsg0.........    .CMD.  .TXT.  .HDR.  .VAR.  .ALT.  .MSE.  .ERR.  .ATT.

.pimsg1.........

=assign visual attributes
+		    .pim.. .t     .t     .t     .t     .t     .t     .t  
+    prompter/pmt:  .P..   .t..   .t..   .t..   .t..   .t..   .t..   .t.. 
+     outstand/so:  .so.   .t..   .t..   .t..   .t..   .t..   .t..   .t.. 
+    underline/us:  .us.   .t..   .t..   .t..   .t..   .t..   .t..   .t..
+  bright/bold/md:  .md.   .t..   .t..   .t..   .t..   .t..   .t..   .t..
+      reverse/mr:  .mr.   .t..   .t..   .t..   .t..   .t..   .t..   .t.. 
+        blink/mb:  .mb.   .t..   .t..   .t..   .t..   .t..   .t..   .t.. 
+		    .pim.. .t     .t     .t     .t     .t     .t     .t  
+              fg:  .fg.   .t..   .t..   .t..   .t..   .t..   .t..   .t.. 
+              bg:  .bg.   .t..   .t..   .t..   .t..   .t..   .t..   .t..
+   stripe select:  .sgr   .t..   .t..   .t..   .t..   .t..   .t..   .t..
+       code edit:  .hl... .hl... .hl... .hl... .hl... .hl... .hl... .hl...
+		    .pim.. .t     .t     .t     .t     .t     .t     .t  

             mode:  .sgrm..........     .sgrAT.....          get help: .:HE....

---#	:  :       :...   :...   :...   :...   :...   :...   :...   :...  :........:
---#	:  :          :...  :...  :...  :...  :...  :...  :...  :...  :........:
---#+    .hl...............................................................
---#+	.hl............................................
---#+									
---#+    :mk/hidden         .mk.  .t..  .t..  .t..  .t..  .t..  .t..  .t..
---#+    :vs/background     .vs.  .t..  .t..  .t..  .t..  .t..  .t..  .t..    

---END
