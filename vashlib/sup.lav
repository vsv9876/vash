---PAGE sup
---LINES
versn	= gv   -       -       cvt_sp  -       versn
---#versn	= v    -       -       cvt_sp  -       versn
vexdir  = v    -       -       cvt_sp  -       vexdir
vpath   = v    -       -       cvt_sp  -       vpath
vashrc  = v    -       -       cvt_sp  -       vashrc
buildd  = c    buildd

hl      = gc    -       -       cvt_hl  -       "-"
coprts  = c     coprts
fs      = ipv   -       -       cvt_sp  -       f
is      = ipv   -       -       cvt_s   -       i
os      = ipv   -       -       cvt_s   -       o
rs      = ipv   -       -       cvt_s   -       r

---#    = ipa
p       = ia    -       onoff   cvt_a   -       pF
w       = ia    -       onoff   cvt_a   -       wF
s       = ia    -       onoff   cvt_a   -       sF
h       = ia    -       onoff   cvt_a   -       hF
S       = ia    -       onoff   cvt_a   -       hS
c       = ia    -       onoff   cvt_a   -       cF
m       = ia    -       onoff   cvt_a   -       mF
x       = ia    -       onoff   cvt_a   -       xF

---#u8nopa  = ia    -       onoff   cvt_a   -       u8nopa
u8      = ia    -       onoff   cvt_a   -       u8nopa

---# TODO to be continued...
F1	= c "..."
F2	= c "."

---# suspend on new line key before debug section below
---#ym      = iv    n       "%3d"   -       t_ymax  yy_max
ym      = iv    -       "%3d"   -       t_ymax  yy_max

y0      = g     -       "%3d"   -       -       y0
yt      = g     -       "%3d"   -       -       y0_top
li      = v     -       "%3d"   -       -       maxli
co      = v     -       "%3d"   -       -       maxco
bli	 = vi    -      "%d"   -       -       baseli
lli      = vi    -      "%d"   -       -       lmaxli






---SCREEN
."vash setup parameters"......................... help: .:HE....  exit: .:EX....

+max .ym lines       .h.-h,history   .s.-s,scroll        .F1  sh -c allways
+    .li maxli       .S.-S,sync      .p.-p,panel/keybar  .u8  only ASCII
+    .co maxco       .m.-m,mail_biff .w.-w,title               
+                    .c.-c,clock     .x.-x,xterm title
                                                                
 ."debug only parameters"....................................       
+--  .fs......................................................      baseli .bli
+-@  .rs......................................................      lmaxli .lli            
+-i  .is......................................................      y0_top .yt
+                                                                       y0 .y0
---#+ -o: .os........................................................   y0 .y0
vashrc: .vashrc.................................................................
vapath: .vpath..................................................................
vexdir: .vexdir.................................................................
						  
=Visual Assistant Shell
 .coprts......................................................................
 License: MIT or BSD      version: .versn............ build date: .buildd......           
---END                             

---#     1         2         3         4         5         6         7         8
---#56789 123456789 123456789 123456789 123456789 123456789 123456789 1234567890
---#

---# use for debug in SCREEN section
---#    y0:     .y0.
---#    y0_top: .y0t
---#
---#  Please, to return try Ctrl-E or .:EX....
---#	   to get help press     .'?    or .:HE....
---#
+    .ym lines max   
+co  .co......       
+li  .li .bli....bli 
+y0t .yt .lli..-lmax 
