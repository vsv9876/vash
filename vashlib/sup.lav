---PAGE sup
---LINES
versn	= g    -       -       cvt_sp  -       versn
---#versn	= v    -       -       cvt_sp  -       versn
vpath   = g    -       -       cvt_sp  -       vpath
vashrc  = g    -       -       cvt_sp  -       vashrc
vexdir  = g    -       -       cvt_sp  -       vexdir
buildd  = c    buildd

hl      = gc    -       -       cvt_hl  -       "-"
coprts  = c     coprts
fs      = ipv   -       -       cvt_sp  -       f
is      = ipv   -       -       cvt_s   -       i
os      = ipv   -       -       cvt_s   -       o
rs      = ipv   -       -       cvt_s   -       r

---#    = ipa
p       = ia    -       onoff   cvt_a   -       pF
w       = ia    -       onoff   cvt_a   -       wF
s       = ia    -       onoff   cvt_a   -       sF
h       = ia    -       onoff   cvt_a   -       hF
S       = ia    -       onoff   cvt_a   -       hS
c       = ia    -       onoff   cvt_a   -       cF
m       = ia    -       onoff   cvt_a   -       mF
x       = ia    -       onoff   cvt_a   -       xF

---#u8nopa  = ia    -       onoff   cvt_a   -       u8nopa
u8      = ia    -       onoff   cvt_a   -       u8nopa

---# TODO to be continued...
F1	= c "..."
F2	= c "."

---# suspend on new line key before debug section below
---#ym      = iv    n       "%3d"   -       t_ymax  yy_max
ym      = ivp   -       "%3d"   -       t_ymax  yy_max

y0      = g     -       "%3d"   -       -       y0
yt      = g     -       "%3d"   -       -       y0_top
li      = g     -       "%3d"   -       -       maxli
co      = g     -       "%3d"   -       -       maxco
bli	 = vip   -      "%3d"  -       -       baseli
lli      = vip   -      "%3d"  -       -       lmaxli
C       = ipv    -      "%1d"  -       -       SGR




---SCREEN
."vash setup parameters"......................... help: .:HE....  exit: .:EX....

+max .ym. lines      .h. h,history   .s. s,scroll        .F1 anyway sh -c
+                    .S. S,sync      .p. p,panel/keybar  .u8 only ASCII KBD
+    .lli:lmaxli     .m. m,mail_biff .w. w,title               
+    .bli:baseli     .c. c,clock     .x. x,xterm title
                                                               
 ."debug of profiles                                        ".      maxli: .li  
+--  .fs......................................................      maxco: .co 
+-@  .rs......................................................     y0_top: .yt
+-i  .is......................................................         y0: .y0
+                                                                 
+    .C - color mode                                      

---#+ -o: .os........................................................          
vashrc: .vashrc.................................................................
vapath: .vpath..................................................................
vexdir: .vexdir.................................................................
						  
