---PAGE sup
---LINES
versn	= gv   -       -       cvt_sp  -       versn
---#versn	= v    -       -       cvt_sp  -       versn
vexdir  = v    -       -       cvt_sp  -       vexdir
vpath   = v    -       -       cvt_sp  -       vpath
vashrc  = v    -       -       cvt_sp  -       vashrc
buildd  = c    buildd

hl      = gc    -       -       cvt_hl  -       "-"
coprts  = c     coprts
f       = ipv   -       -       cvt_sp  -       f
i       = ipv   -       -       cvt_s   -       i
o       = ipv   -       -       cvt_s   -       o
r       = ipv   -       -       cvt_s   -       r

---#    = ipa
pF      = ia    -       onoff   cvt_a   -       pF
wF      = ia    -       onoff   cvt_a   -       wF
sF      = ia    -       onoff   cvt_a   -       sF
hF      = ia    -       onoff   cvt_a   -       hF
hS      = ia    -       onoff   cvt_a   -       hS
cF      = ia    -       onoff   cvt_a   -       cF
mF      = ia    -       onoff   cvt_a   -       mF
xF      = ia    -       onoff   cvt_a   -       xF

u8nopa  = ia    -       onoff   cvt_a   -       u8nopa

---# TODO to be continued...
F1	= c "."
F2	= c "."

---# suspend on new line key before debug section below
---#ym      = iv    n       "%3d"   -       t_ymax  yy_max
ym      = iv    -       "%3d"   -       t_ymax  yy_max

y0      = v     -       "%d"   -       -       y0
yt      = g     -       "%d"   -       -       y0_top
li      = g     -       "%d"   -       -       maxli
co      = g     -       "%d"   -       -       maxco

---# use for debug in SCREEN section
---#    y0:     .y0.
---#    y0_top: .y0t
---#
---#  Please, to return try Ctrl-E or .:EX....
---#	   to get help press     .'?    or .:HE....
---#

---SCREEN
---#     1         2         3         4         5         6         7         8
---#56789 123456789 123456789 123456789 123456789 123456789 123456789 1234567890
---#
=vash setup parameters

+   .ym. lines max     .hF h,history     .sF s,scroll        .F1 sh -c allways
+       maxco: .co     .hS S,sync        .pF p,panel/keybar  .u8nopa only ASCII
+       maxli: .li     .mF m,mail_biff   .wF w,title               
+       y0top: .yt     .cF c,clock       .xF x,xterm title         
                                                                  
."Please, use manual for parameters below:".       help: .:HE.... exit: .:EX.... 
+-- .f.........................................................
+-@ .r.........................................................
+-i .i.........................................................
---#+ -o: .o.........................................................

vashrc: .vashrc.................................................................
vapath: .vpath..................................................................
vexdir: .vexdir.................................................................
						  
