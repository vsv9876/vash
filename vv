#
# Setup environment for debug vash
#
# check scipt name (may be symlinked)
#echo ./v?

# regular vash options (may be vary)
export VASH=+xpsw

# step trace of linlib output:
# additional fflash(stdout) on every fputs()
VISI_DEBUG=1

# perform fflush(stdout) and little suspend
# x on every character outputed, in msec
##export VISI_DEBUG_IOS=200
export VISI_DEBUG_IOS=100

# trace io_set() with messages
export VISI_DEBUG_IO=0

# trace tcsetpgrp and signals with messages
export VASH_PGRP=0

# prompt printing with process number on every start the vash
# (suspend execution of vash until debugger start and connect)
export VASH_DEBUG=1

# help to reanimate tty after vash crash
alias tt='stty sane'
