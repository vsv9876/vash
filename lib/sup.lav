---PAGE sup
---LINES
versn	= gc   -       -       cvt_sp  -       versn
---#versn	= v    -       -       cvt_sp  -       versn
vpath   = gc   -       -       cvt_sp  -       vpath
vashrc  = gc   -       -       cvt_sp  -       vashrc
vexdir  = gc   -       -       cvt_sp  -       vexdir
buildd  = c    buildd

hl      = gc    -       -       cvt_hl  -       "-"
coprts  = c     coprts
fs	    = ipv   -       -       cvt_sp  -       f
fo	    = ipv   o       -       -       -       f_o
is      = ipv   -       -       cvt_s   -       i
os      = ipv   -       -       cvt_s   -       o
rs      = ipv   -       -       cvt_s   -       r

---#    = ipa
p       = ia    -       onoff   cvt_a   -       pF
w       = ia    -       onoff   cvt_a   -       wF
s       = ia    -       onoff   cvt_a   -       sF
h       = ia    -       onoff   cvt_a   -       hF
S       = ia    -       onoff   cvt_a   -       hS
c       = ia    -       onoff   cvt_a   -       cF
m       = ia    -       onoff   cvt_a   -       mF
x       = ia    -       onoff   cvt_a   -       xF
XT      = ia    -       onoff   cvt_a   -       xT
N       = ia    -       onoff   cvt_a   -       NF
A       = ia    -       onoff   cvt_a   -       AF
a       = ia    -       onoff   cvt_a   -       SF
o       = ia    -       onoff   cvt_a   -       SO

---#u8nopa  = ia    -       onoff   cvt_a   -       u8nopa
u8      = ia    -       onoff   cvt_a   -       u8nopa

---# TODO to be continued...
F1	= c "..."
F2	= c "."

---# suspend on new line key before debug section below
---#ym      = iv    n       "%3d"   -       t_ymax  yy_max
ym      = ivp   -       "%3d"   -       t_ymax  yy_max

y0      = gc     -       "%3d"   -       -       y0
yt      = gc     -       "%3d"   -       -       y0_top
li      = gc     -       "%3d"   -       -       maxli
co      = gc     -       "%3d"   -       -       maxco
bli     = vip    -      "%3d"  -       -       baseli
lli     = vip    -      "%3d"  -       -       lmaxli
C       = ipv    -      "%1d"  -       -       SGR


---SCREEN
."vash setup parameters"......................... help: .:HE....  exit: .:EX....

+   .h. h,history   .s. s,scroll        .A. anyway sh -c     .a. #@ in rc    
+   .S. S,sync      .p. p,panel/keybar  .u8 only ASCII KBD   .o. #@ show pos        
+   .m. m,mail_biff .w. w,title         .XT trap on exit         
+   .c. c,clock     .x. x,xterm title   .N. help msg on trap     
                                                                        
+."debug of profiles"..................                      .yt:y0_top      
+-- .fo................................ .ym.:linesmax        .y0:y0          
+-@ .rs................................ .lli:lmaxli          .li:maxli       
+-i .is................................ .bli:baseli          .co:maxco       
+                                                           
+                                       .C - color mode
---#+ -o: .os........................................................          

vashrc: .vashrc.................................................................
vapath: .vpath..................................................................
vexdir: .vexdir.................................................................
						  
=Visual Assistant Shell
 .coprts......................................................................
