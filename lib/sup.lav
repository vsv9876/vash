---PAGE sup
---LINES
versn	= gc   -       -       cvt_sp  -       versn
---#versn	= v    -       -       cvt_sp  -       versn
vpath   = gc   -       -       cvt_sp  -       vpath
vashrc  = gc   -       -       cvt_sp  -       vashrc
vexdir  = gc   -       -       cvt_sp  -       vexdir
buildd  = c    buildd

hl      = gc    -       -       cvt_hl  -       "-"
coprts  = c     coprts
fs	    = ipv   -       -       cvt_sp  -       f
fo	    = ipv   o       -       -       -       f_o
is      = ipv   -       -       cvt_s   -       i
os      = ipv   -       -       cvt_s   -       o
rs      = ipv   -       -       cvt_s   -       r

p       = ia    -       onoff   cvt_a   -       pF
w       = ia    -       onoff   cvt_a   -       wF
s       = ia    -       onoff   cvt_a   -       sF
H       = ia    -       onoff   cvt_a   -       HF
S       = ia    -       onoff   cvt_a   -       SF
c       = ia    -       onoff   cvt_a   -       cF
m       = ia    -       onoff   cvt_a   -       mF
x       = ia    -       onoff   cvt_a   -       xF
T       = ia    -       onoff   cvt_a   -       TF
N       = ia    -       onoff   cvt_a   -       NF
A       = ia    -       onoff   cvt_a   -       AF
R       = ia    -       onoff   cvt_a   -       RF
a       = ia    -       onoff   cvt_a   -       aF
J       = ia    -       onoff   cvt_a   -       JF
P       = gc    -       onoff   cvt_a   -       PP
u8      = ia    -       onoff   cvt_a   -       u8nopa

pF      = gc    -       -       cvt_fd  -       pF
wF      = gc    -       -       cvt_fd  -       wF
sF      = gc    -       -       cvt_fd  -       sF
HF      = gc    -       -       cvt_fd  -       HF
SF      = gc    -       -       cvt_fd  -       SF
cF      = gc    -       -       cvt_fd  -       cF
mF      = gc    -       -       cvt_fd  -       mF
xF      = gc    -       -       cvt_fd  -       xF
TF      = gc    -       -       cvt_fd  -       TF
NF      = gc    -       -       cvt_fd  -       NF
AF      = gc    -       -       cvt_fd  -       AF
RF      = gc    -       -       cvt_fd  -       RF
aF      = gc    -       -       cvt_fd  -       aF
JF      = gc    -       -       cvt_fd  -       JF
PP      = gc    -       -       cvt_fd  -       PP

---#u8nopa  = ia    -       onoff   cvt_a   -       u8nopa
u8      = ia    -       onoff   cvt_a   -       u8nopa

---# TODO to be continued...
F1	= c "..."
F2	= c "."

---# suspend on new line key before debug section below
---#ym      = iv    n       "%3d"   -       t_ymax  yy_max
ym      = ivp   -       "%3d"   -       t_ymax  yy_max

y0      = gc     -       "%3d"   -       -       y0
yt      = gc     -       "%3d"   -       -       y0_top
li      = gc     -       "%3d"   -       -       maxli
co      = gc     -       "%3d"   -       -       maxco
bli     = gc     -      "%3d"  -       -       baseli
lli     = gc     -      "%3d"  -       -       lmaxli
C       = ipv    -      "%1d"  -       -       SGR


---SCREEN
."vash setup parameters"......................... help: .:HE....  exit: .:EX....

+   .H. .HF........ .s. .sF...........  .A. .AF...........  .R. .RF............
+   .S. .SF........ .p. .pF...........  .J. .JF...........  .a. .aF............
+   .m. .mF........ .w. .wF...........  .T. .TF...........  .P. .PP............
+   .c. .cF........ .x. .xF...........  .N. .NF...........  .u8 only ASCII KBD
                                                      
+."debug of profiles"..................                      .yt:y0_top      
+-- .fo................................ .ym.:linesmax        .y0:y0          
+-@ .rs................................ .lli:lmaxli          .li:maxli       
+-i .is................................ .bli:baseli          .co:maxco       
+                                                           
+                                       .C - color mode
---#+ -o: .os........................................................          

vashrc: .vashrc.................................................................
vapath: .vpath..................................................................
vexdir: .vexdir.................................................................
						  
