---PAGE supage
---LINES
stdfile	= c ".ashstd"
vexdir  = v    -       -       cvt_sp  -       vexdir
hl      = gc    -       -       cvt_hl  -       "-"
f       = ipv   -       -       -       -       f
i       = ipv   -       -       -       -       i
o       = ipv   -       -       -       -       o

panl    = ipa   -       onoff   cvt_a   -       pF
scrl    = ipa   -       onoff   cvt_a   -       sF
hist    = ipa   -       onoff   cvt_a   -       hF
clck    = ipa   -       onoff   cvt_a   -       cF
ymax    = ipv   -       "%4d"   -       t_ymax  yy_max





---SCREEN
=vash setup in brief
				    Please, use man vash for full description
               ."preferences". 
 max lines     number of screen lines (rows) allowed for main menu
 history/sync  history save on exit or sync on every command
 scroll        keep command listing or clear screen on every command
 panel/keybar  show action labels of keys 0...9 
 title(who)    title of vash session - depends on environment .'VASH_LABEL
 title on xterm if supported by X window manager
 mail_biff     indicate new mail incoming
 clock         show clock, during screen mode only

               ."readonly runtime parameters                                 ".
 maxli/maxco   maximum lines/columns (size of the screen)
 vexdir        search path for directories with configuration files

               ."debug of profiles                                           ".
               NOTE: it's better to don't touch if not sure, read manual 1st
 --:           command for fill of main menu
 -i:           input file - whatching it for new scan of main menu
 -@:           substitution rule for items from main menu
---# -o:           parameter not used, reserved
---END
