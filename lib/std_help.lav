---LINES

mainv   = h   " main view                         "
mainvk  = c   "main view keys:"

cmded   = h   " command editor                  "
cmdedk  = c   "command editor keys:"

exit    = h   " exit trap                "
exitk   = c   "keys of trap on exit:"

hist    = h   " history view             "
histk   = c   "history view keys:"

runcmd  = hm "run a command"

---# m       = gm  - - - - " *)"
m       = g  - - - - " *)"
---# a       = cx "<1>"
---# b       = cx "<2>"
---# c       = cx "<3>"
a       = cx "1:"
b       = cx "2:"
c       = cx "3:"

X	= hx "[=]"
cmd     = hx "[a-z./]"
CMD     = hx "[A-Z0-9]"

---SCREEN
=vash workflow -- context switching                                      
!                                             
!.mainvk............................... please, see 'man vash' for more details                                       
! .'lowercase,dot,slash                                                    
!     type a command from scratch  .a                   .:HE... help            
! .'uppercase,digit                                     .:EX... exit,return           
!     edit a command from template .b                   .:CA    cancel                
!     execute predefined command   .c        
!                                           .mainv............................. 
! .:CA switch editor <--> main view          ^ .:CA    ^       .cmd... .CMD....
!                                            :   :     :            :    :   : 
!.cmdedk...............................      :   :  .X.:           .a    :   : 
! .:HE... switch to history view             :   : .hist..........  :   .b   :
! .:NL... run a command                      :   :    ^     .:NL... :    :  .c
!                                            :   :    :        :    :    :   :
!.histk................................      : .:CA .:HE...    :    :    :   :  
! .:NL... take a command to editor           : .cmded....................... :  
! .:CA    back to editor untouched           :        ^            .:NL...   :    
!                                            :       .a              :       :    
!.exitk................................     .:CA      :              :       :    
! .:SP...| .:CA return to main view         .:SP... .cmd...    .runcmd.........  
! .'lovercase  return to editor             .exit.......... <--                  
                                       
---END                                                                         
+  .:NL...  - defencive trap for mistakes   
                                      
