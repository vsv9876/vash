# GNU/Linux (Debian)
#
# debian use old ncurses,
# this is portable build with static linkage
#
CFLAGS_VISI = -DUSE_TERMIOS
CFLAGS_ASH  = -DJCLsuspend -DSVR4 -DMGROUPS -DLUNIX -DSTRVERSCMP
ASHLIB      = SVR4
#TERMLIB     = -ltermcap
TERMLIB     = -lncurses
#TERMLIB     = -ltinfo

CC          = gcc $(DEBUG) -std=gnu89 -Wwrite-strings
##			-std=gnu89 -Wwrite-strings -Wno-implicit-int

LINKER      = gcc $(DEBUG) -fno-builtin-function -static
