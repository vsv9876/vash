#
# Darwin
# (MacOS, tested on 11.7.11 Big Sur)
#
# mandatory because installing into /usr forbidden...
DEST	= /usr/local

CFLAGS_VISI = -DUSE_TERMIOS -DNO_ALLOCA_H
CFLAGS_ASH    = -DJCLsuspend -DBSDpagesize -DMGROUPS \
				-DNO_STRVERSCMP
# if BSD-like      PREDEF=1
# if any MacOS     PREDEF=2 (not yet, sory)
# else (SYSV,SVR4) PREDEF=0 (omitted if not specified there)
PREDEF       = 1

TERMLIB     = -ltermcap
#TERMLIB     = -ltinfo

# checked on MacOSX11.7.Internal.sdk
CC          = clang $(DEBUG) -std=c89 -Wwrite-strings

LINKER      = clang $(DEBUG)

