
# FreeBSD
# FreeBSD, BSDI, or any *BSD
#CFLAGS_VISI = -DUSE_TERMIOS_386BSD -DNOUSE_STRCHR
CFLAGS_VISI = -DUSE_TERMIOS -DNO_ALLOCA_H
CFLAGS_ASH    = -DJCLsuspend -DFbsd -DBSDpagesize -DBSDmagic -DMGROUPS \
				-DNO_STRVERSCMP

# if BSD-like      PREDEF=1
# else (SYSV,SVR4) PREDEF=0 (omitted if not specified there)
PREDEF       = 1

#TERMLIB     = -ltermcap
TERMLIB     = -ltinfo

#CC          = gcc -traditional
#LINKER      = gcc -traditional

# checked on FreeBSD 14.1-RELEASE
CC          = cc $(DEBUG) -std=c89 -Wwrite-strings

LINKER      = cc $(DEBUG)

