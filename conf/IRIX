CFLAGS_VISI = -DUSE_TERMIOS -DLCASE=XCASE
CFLAGS_ASH  = -DJCLsuspend -DSYSV -DSVR4 -DMGROUPS
ASHLIB      = SVR4
#TERMLIB     = -ltermcap #not shure...
