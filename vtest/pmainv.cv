/*
 *      $Header$
 *      $Log$
 */

static char fmtd[10] = "%.20lf";
static char fmtf[10] = "%.5f";
static char fmtl[10] = "%ld";
static char fmth[10] = "%hd";
static char fmti[10] = "%d";

---PAGE linem
---LINES
m_exit      = ipm      -   -    mkexit     tst_m    " quit "
m_navi      = ipm      n   -    p_navi     tst_m    " navi "
m_sutf      = ipm      n   -    p_suputf8  tst_m    " utf8 "

fd      = iv    -   -           -       -   fmtd
ff      = iv    -   -           -       -   fmtf
fl      = iv    -   -           -       -   fmtl
fh      = iv    -   -           -       -   fmth
fi      = iv    -   -           -       -   fmti

---#s_vd	= ipv   -   "%.20lf"    -       -   &vd
---#s_vf	= ipv   -   "%.5f"      -       -   &vf
---#s_vl	= ipv   -   "%ld"       -       -   &vl
---#s_vh	= ipv   -   "%hd"       -       -   &vh
---#s_vi	= ipv   -   "%d"        -       -   &vi
s_vd		= ipv   -   fmtd        -       -   &vd
s_vf		= ipv   -   fmtf        -       -   &vf
s_vl		= ipv   -   fmtl        -       -   &vl
s_vh		= ipv   -   fmth        -       -   &vh
s_vi		= ipv   -   fmti        -       -   &vi

li      = gc     -      "%3d"   -       -      &hwframe.maxli
co      = gc     -      "%3d"   -       -      &hwframe.maxco
bli     = vip    -      "%3d"  -       -       &lfmain.baseli

---SCREEN
=testing VISI/LINLIB V4-Unicode library + runtime

           .m_exit....... 
           .m_navi....... 
           .m_sutf....... 

  s_double .fd..... .s_vd................
  s_float  .ff..... .s_vf..........       
  s_long   .fl..... .s_vl.....
  s_short  .fh..... .s_vh.....
  s_int    .fi..... .s_vi.                                          

                          

          .li.x .co .bli          .'+=    dump numbers

           .m_exit..     

                                  .:HE.... get help
---END                                            
