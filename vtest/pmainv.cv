---PAGE linem
---LINES
m_exit  = ipm      -   -   mkexit  tst_m   " close, quit "

s_raw   = ipv      -   -	-       -	u8s
s_var   = ipv      -   -	cvt_s   -	u8s
s_tst   = ipv      -   -	cvt_s   -	u8s
s_vd	= ipv      -   "%.20lf" -	-	&vd
s_vf	= ipv      -   "%.5f"	-	-	&vf
s_vl	= ipv      -   "%ld"	-       -	&vl
s_vh	= ipv      -   "%hd"	-       -	&vh
s_vi	= ipv      -   "%d"	-       -	&vi
---# unsupported


---SCREEN
=testing in runtime library ov VISI/LINLIB V4-Unicode



	          .m_exit.......            
                                            
	str_raw   .s_raw..                  
	str_var   .s_var..                  .'?,/       dump string
	str_tst   .s_tst..                  
	s_double  .s_vd.................    .'+,=       dump numbers
	s_float   .s_vf..........           
	s_long    .s_vl.....                .:KI..  dump string with byte hex
	s_short   .s_vh.....                
	s_int     .s_vi.                    .:HE....  get help





---END
