---PAGE suputf8
---LINES
e_tst1      = ipm      n   dim1 e_tst   m_test   " edit1 "
e_tst2      = ipm      n   dim2 e_tst   m_test   " edit2 "

---# wcso, u8so; wcoptr, u8optr 
o_tst1      = iv       w   -    -       -        &wcso
op_tst1     = ipv      w   -    -       -        &wcso
o_u8        = iv       o   -    -       -        &u8so
op_u8       = ipv      o   -    -       -        &u8so

d1      = ipv   -   -           -       -   dim1
d2      = ipv   -   -           -       -   dim2

s_raw   = ipv   -   -           -       -   u8s
s_var   = ipv   -   -           cvt_s   -   u8s
s_tst   = ipv   -   -           cvt_s   -   u8s

---SCREEN
=testing unicode support

  str_raw:          .s_raw.                     .'?/  show the wcso
  str_var:          .s_var..                    .'|\  dump the str
  str_tst:          .s_tst..........

          wcso:     .o_tst1..< .op_tst1....<
          u8so:     .o_u8....< .op_u8......<
                        
     e_str(d1): .d1 .e_tst1...                  .'"'  e_str(3)
     e_str(d2): .d2 .e_tst2...                  .':;  e_str(5)
                                                
                                                   .:EX.... done,return             
  中文素养  国际站  Привет
                    -123456789-123456789-123456789-123456789-

---END                                            
